# DSi PDA launcher. Build from WSL with:  make
# tools/build.sh builds the loader blobs, the ROM, the test ROM and runs host tests.

BLOCKSDS    ?= /opt/wonderful/thirdparty/blocksds/core
BLOCKSDSEXT ?= /opt/wonderful/thirdparty/blocksds/external

NAME          := pda
GAME_TITLE    := PDA
GAME_SUBTITLE := Notes, to-do, calendar
GAME_AUTHOR   := DsiLauncher
GAME_ICON     := icon.bmp

SOURCEDIRS := source
INCLUDEDIRS := source
# load.bin and bootstub.bin are generated by tools/build.sh (or `make blobs`).
BINDIRS    := data

# The stock BlocksDS ARM7 (arm7_maxmod.elf) plus a volume watcher for the
# DSi volume rocker, built from third_party/arm7 by `make blobs`.
ARM7ELF     := third_party/arm7/arm7_maxmod.elf

include $(BLOCKSDS)/sys/default_makefiles/rom_arm9/Makefile

CFLAGS += -Wextra -Wno-unused-parameter -std=gnu17

# The loader blobs must exist before the main Makefile scans BINDIRS.
.PHONY: blobs
blobs:
	$(MAKE) -C third_party/nds-bootloader -f Makefile.blocksds OUT=$(CURDIR)/data/load.bin
	$(MAKE) -f tools/bootstub.mk OUT=$(CURDIR)/data/bootstub.bin
	$(MAKE) -C third_party/arm7 -f Makefile.generic NAME=maxmod USE_MAXMOD=1 \
		BLOCKSDS=$(BLOCKSDS) --no-print-directory
